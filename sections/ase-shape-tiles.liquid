{% comment %}
  Shop-by-shape tiles for collection pages.

  Turns one list filter (default "Style") into a row of picture tiles above
  the product grid. A tile click shows only that shape: it replaces any shape
  already chosen and keeps every other filter (color, price, sort). Clicking
  the active tile, or "All", removes the shape filter.

  Tile pictures come from the "Picture products" setting: for each filter
  value, the first listed product whose filter metafield holds that value
  lends its featured image. Filter values carry no image of their own, and
  collection.products is already narrowed by the active filters, so it
  can't be used to find a picture for shapes that are filtered out.

  The section renders nothing unless the filter has 2+ values and at least
  one of them has a picture, so it can sit in a template shared by
  collections that don't sell by shape.

  Links work without JavaScript. With it, clicks go through Horizon's
  facets form (no page reload), and the section re-renders itself after
  every collection update so counts and the active tile stay in sync with
  the filter bar.
{% endcomment %}

{% liquid
  assign shape_filter = nil
  assign wanted_label = section.settings.filter_option | strip | downcase

  for filter in collection.filters
    assign filter_label = filter.label | downcase
    if filter_label == wanted_label and filter.type == 'list'
      assign shape_filter = filter
      break
    endif
  endfor

  assign tile_count = 0
  assign pictured_count = 0

  if shape_filter != nil and shape_filter.values.size > 1
    # Metafield the pictures are matched on, parsed from e.g. filter.p.m.ase.style
    assign mf_namespace = ''
    assign mf_key = ''
    assign param_name = shape_filter.values.first.param_name
    if param_name contains 'filter.p.m.'
      assign mf_parts = param_name | remove_first: 'filter.p.m.' | split: '.'
      assign mf_namespace = mf_parts[0]
      assign mf_key = mf_parts[1]
    endif

    # Drop the words every label shares ("Premium DMC Sew-On Rivoli" -> "Rivoli")
    assign labels = shape_filter.values | map: 'label'
    assign shared_prefix = ''
    assign candidate = ''
    assign first_words = labels.first | split: ' '
    for word in first_words
      if forloop.last
        break
      endif
      assign candidate = candidate | append: word | append: ' '
      assign candidate_size = candidate | size
      assign all_share = true
      for label in labels
        assign label_head = label | slice: 0, candidate_size
        if label_head != candidate or label.size <= candidate_size
          assign all_share = false
          break
        endif
      endfor
      if all_share
        assign shared_prefix = candidate
      else
        break
      endif
    endfor

    # Square tile picture widths for the srcset; covers ~160px tiles at 3x
    assign tile_image_sizes = '160,240,320,480' | split: ','

    assign active_count = shape_filter.active_values.size
    assign total_count = shape_filter.values | map: 'count' | sum

    assign base_url = shape_filter.url_to_remove
    assign joiner = '?'
    if base_url contains '?'
      assign joiner = '&'
    endif
  endif
%}

{% capture tiles %}
  {%- if shape_filter != nil and shape_filter.values.size > 1 -%}
    {%- for value in shape_filter.values -%}
      {%- liquid
        assign tile_count = tile_count | plus: 1

        assign picture = nil
        if mf_namespace != blank
          for picture_product in section.settings.products
            assign mf = picture_product.metafields[mf_namespace][mf_key]
            if mf == blank
              continue
            endif
            if mf.type contains 'list.'
              if mf.value contains value.value
                assign picture = picture_product.featured_image
                break
              endif
            elsif mf.value == value.value
              assign picture = picture_product.featured_image
              break
            endif
          endfor
        endif
        if picture
          assign pictured_count = pictured_count | plus: 1
        endif

        assign tile_label = value.label
        if shared_prefix != blank
          assign tile_label = value.label | remove_first: shared_prefix
        endif

        if value.active and active_count == 1
          assign tile_url = value.url_to_remove
        elsif active_count == 0
          assign tile_url = value.url_to_add
        else
          # Another shape is active: start from the URL without any shape, then add this one
          capture tile_url
            echo base_url
            echo joiner
            echo value.param_name
            echo '='
            echo value.value | url_encode
          endcapture
        endif

        assign is_disabled = false
        if value.count == 0 and value.active == false
          assign is_disabled = true
        endif
      -%}
      <li class="ase-shape-tiles__item">
        {%- if is_disabled -%}
          <span class="ase-shape-tiles__tile ase-shape-tiles__tile--disabled" aria-disabled="true">
        {%- else -%}
          <a
            class="ase-shape-tiles__tile"
            href="{{ tile_url }}"
            data-shape-tile
            {% if value.active %}
              aria-current="true"
            {% endif %}
          >
        {%- endif -%}
        <span class="ase-shape-tiles__media">
          {%- if picture -%}
            {%- liquid
              # Zoom by cutting a centred square out of the full-size original on
              # Shopify's CDN, rather than enlarging a small image in CSS (blurry).
              # Zoom is measured against a 2000px-tall shot (most stone photos are
              # 3000x2000). A smaller photo, like the 1600x1200 Baguette, is already
              # framed tighter, so it gets less zoom and the stone still fits.
              assign short_side = picture.width | at_most: picture.height
              assign reference_side = short_side | at_least: 2000
              assign crop_side = reference_side | times: 100 | divided_by: section.settings.image_zoom | at_most: short_side
              assign crop_left = picture.width | minus: crop_side | divided_by: 2
              assign crop_top = picture.height | minus: crop_side | divided_by: 2
              assign srcset = ''
              for tile_size in tile_image_sizes
                assign px = tile_size | plus: 0
                assign tile_src = picture | image_url: crop: 'region', crop_left: crop_left, crop_top: crop_top, crop_width: crop_side, crop_height: crop_side, width: px, height: px
                assign srcset = srcset | append: tile_src | append: ' ' | append: px | append: 'w'
                unless forloop.last
                  assign srcset = srcset | append: ', '
                endunless
              endfor
            -%}
            <img
              src="{{ tile_src }}"
              srcset="{{ srcset }}"
              sizes="(min-width: 750px) 160px, 92px"
              width="{{ tile_image_sizes | last }}"
              height="{{ tile_image_sizes | last }}"
              loading="lazy"
              alt=""
              class="ase-shape-tiles__image"
            >
          {%- else -%}
            <span class="ase-shape-tiles__initial" aria-hidden="true">{{ tile_label | slice: 0 }}</span>
          {%- endif -%}
        </span>
        <span class="ase-shape-tiles__label">{{ tile_label | escape }}</span>
        {%- if section.settings.show_count -%}
          <span class="ase-shape-tiles__count">{{ value.count }}</span>
        {%- endif -%}
        {%- if is_disabled -%}
          </span>
        {%- else -%}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endif -%}
{% endcapture %}

{% if pictured_count > 0 %}
  <div class="section-background"></div>
  <div
    class="section section--{{ section.settings.section_width }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <ase-shape-tiles
      class="ase-shape-tiles"
      data-section-id="{{ section.id }}"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="ase-shape-tiles__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="ase-shape-tiles__scroller">
        <ul class="ase-shape-tiles__list" role="list">
          <li class="ase-shape-tiles__item">
            <a
              class="ase-shape-tiles__tile"
              href="{{ base_url }}"
              data-shape-tile
              {% if active_count == 0 %}
                aria-current="true"
              {% endif %}
            >
              <span class="ase-shape-tiles__media ase-shape-tiles__media--all" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor">
                  <circle cx="7" cy="7" r="4" /><circle cx="21" cy="7" r="4" />
                  <circle cx="7" cy="21" r="4" /><circle cx="21" cy="21" r="4" />
                </svg>
              </span>
              <span class="ase-shape-tiles__label">{{ section.settings.show_all_label | escape }}</span>
              {%- if section.settings.show_count -%}
                <span class="ase-shape-tiles__count">{{ total_count }}</span>
              {%- endif -%}
            </a>
          </li>
          {{ tiles }}
        </ul>
      </div>
    </ase-shape-tiles>
  </div>
{% endif %}

{% stylesheet %}
  .ase-shape-tiles {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ase-shape-tiles__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Tiles share the row on desktop and scroll sideways on phones */
  .ase-shape-tiles__scroller {
    overflow-x: auto;
    scrollbar-width: thin;
    margin-inline: -4px;
    padding: 4px;
  }

  .ase-shape-tiles__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 92px;
    gap: 10px;
  }

  @media screen and (min-width: 750px) {
    .ase-shape-tiles__list {
      grid-auto-columns: minmax(104px, 1fr);
      gap: 12px;
    }
  }

  .ase-shape-tiles__tile {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .ase-shape-tiles__media {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--card-corner-radius, 4px);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    outline: 1.5px solid transparent;
    outline-offset: 2px;
    transition: outline-color 0.15s ease;
  }

  .ase-shape-tiles__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    transition: transform 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ase-shape-tiles__tile:hover .ase-shape-tiles__image {
      transform: scale(1.06);
    }

    .ase-shape-tiles__tile:hover .ase-shape-tiles__media {
      outline-color: rgb(var(--color-foreground-rgb) / 0.25);
    }
  }

  .ase-shape-tiles__media--all {
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .ase-shape-tiles__initial {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .ase-shape-tiles__label {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .ase-shape-tiles__count {
    margin-top: -4px;
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  .ase-shape-tiles__tile[aria-current='true'] .ase-shape-tiles__media {
    outline-color: var(--color-foreground);
  }

  .ase-shape-tiles__tile[aria-current='true'] .ase-shape-tiles__label {
    font-weight: 700;
  }

  .ase-shape-tiles__tile:focus-visible {
    outline: none;
  }

  .ase-shape-tiles__tile:focus-visible .ase-shape-tiles__media {
    outline: 2px dashed var(--color-foreground);
  }

  .ase-shape-tiles__tile--disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .ase-shape-tiles__image,
    .ase-shape-tiles__media {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ase-shape-tiles')) {
    class AseShapeTiles extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.onClick);
        document.addEventListener('shopify:collection:update', this.onCollectionUpdate);
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.onClick);
        document.removeEventListener('shopify:collection:update', this.onCollectionUpdate);
      }

      onClick = (event) => {
        const tile = event.target.closest('[data-shape-tile]');
        if (!tile || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;

        const facetsForm = document.querySelector('facets-form-component');
        if (!facetsForm || typeof facetsForm.updateFiltersByURL !== 'function') return;

        event.preventDefault();
        // Show the new active tile straight away; the re-render confirms it.
        this.querySelectorAll('[data-shape-tile]').forEach((link) => {
          if (link === tile) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        facetsForm.updateFiltersByURL(tile.href);
      };

      // Any filter change (tiles, filter bar, removing a pill) re-renders this
      // section so its counts and active tile match the new results.
      onCollectionUpdate = async (event) => {
        const sectionId = this.dataset.sectionId;
        if (!sectionId) return;
        try {
          await event.promise;
          const { sectionRenderer } = await import('@theme/section-renderer');
          await sectionRenderer.renderSection(sectionId);
        } catch (error) {
          console.error(error);
        }
      };
    }

    customElements.define('ase-shape-tiles', AseShapeTiles);
  }
{% endjavascript %}

{% schema %}
{
  "name": "ASE Shape tiles",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Filter"
    },
    {
      "type": "text",
      "id": "filter_option",
      "label": "Filter option name",
      "info": "Enter the filter label exactly as it appears in your Shopify filters (e.g., Style, Shape).",
      "default": "Style"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Picture products",
      "info": "One product per shape. Each tile uses the featured image of the first product here that has that shape. The tiles only show on collections where at least one shape has a picture.",
      "limit": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by shape"
    },
    {
      "type": "text",
      "id": "show_all_label",
      "label": "Show all label",
      "default": "All shapes"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Picture zoom",
      "info": "Shows the middle of each photo, cut from the full-size original so it stays sharp. Photos smaller than 2000px tall are zoomed less, since they are already framed tighter.",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "%",
      "default": 200
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "ASE Shape tiles"
    }
  ]
}
{% endschema %}
